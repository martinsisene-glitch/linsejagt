{
  "_readme": [
    "Dette er den eneste fil du normalt skal redigere.",
    "newPriceDKK  = hvad objektivet koster NYT i Danmark lige nu (bruges til '% under nypris').",
    "usedBaselineDKK = normal brugtpris — bruges til at se om en annonce er billig FOR brugtmarkedet.",
    "priceVerified = sæt til true når du selv har tjekket nyprisen hos en forhandler. Alt med false",
    "                vises som 'estimat' i sidens footer, så du ved hvad du kan stole på.",
    "codes  = Sonys modelkoder. Det er den sikreste måde at genkende et objektiv på.",
    "match  = løsere regex-mønstre (køres mod en normaliseret titel: 'f/1,8' bliver '1.8', '50 mm' bliver '50mm').",
    "exclude = regex der DISKVALIFICERER en annonce for netop dette objektiv (fx forveksling med GM-udgaven).",
    "watch  = true betyder 'giv mig besked' — driver RSS-feed og 'nyt siden sidst'.",
    "Tip: kør 'npm run explain' for at se præcis hvorfor en annonce blev matchet eller afvist."
  ],

  "settings": {
    "shippingDKK": { "tradera": 120, "dba": 50 },
    "fallbackSekToDkk": 0.64,
    "greatDealThreshold": 0.5,
    "goodDealThreshold": 0.3,
    "feedDays": 14,
    "newBadgeHours": 48,

    "_querynote": [
      "Brede søgninger frem for én pr. objektiv: Traderas API-kvote er ikke veldokumenteret,",
      "og 24 objektiver x 12 kørsler i døgnet ville være et unødigt gamble. Brede søgninger",
      "koster et fast antal kald uanset hvor stort kataloget bliver — filtreringen sker lokalt.",
      "Hold øje med 'kald' i build-loggen de første dage."
    ],
    "tradera": {
      "categoryId": 0,
      "pagesPerQuery": 2,
      "queries": [
        "sony fe objektiv",
        "sony e-mount objektiv",
        "sony sel objektiv",
        "sony fe gm",
        "sony objektiv prime",
        "sony fe zoom objektiv",
        "sony e objektiv aps-c",
        "sony alpha objektiv"
      ]
    },
    "dba": {
      "pagesPerQuery": 2,
      "queries": [
        "sony fe objektiv",
        "sony e-mount objektiv",
        "sony sel objektiv",
        "sony gm objektiv",
        "sony objektiv"
      ]
    }
  },

